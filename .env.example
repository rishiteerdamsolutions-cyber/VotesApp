# Neon PostgreSQL (free tier): https://neon.tech — paste your real URL for production
DATABASE_URL=postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require

# Local dev only: use file DB when DATABASE_URL is still the placeholder above.
# Not needed on Vercel (Neon is used automatically when DATABASE_URL is set).
# USE_LOCAL_DB=true

# JWT secret (change in production)
JWT_SECRET=your-random-secret-here

# Default super admin password on first setup (username: admin)
ADMIN_DEFAULT_PASSWORD=1KTR@1

# Optional: API URL for production (leave empty to use same origin /api proxy)
# VITE_API_URL=
