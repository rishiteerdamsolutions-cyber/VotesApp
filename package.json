{
  "name": "votesapp",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "predev": "npm run dev:kill-ports",
    "dev": "concurrently -k -n api,web -c magenta,cyan \"npm run dev:api\" \"wait-on http://127.0.0.1:3001/api/health -t 60000 && npm run dev:web\"",
    "dev:web": "vite",
    "dev:api": "tsx watch server/dev.ts",
    "dev:kill-ports": "lsof -ti :3001,:5173 | xargs kill -9 2>/dev/null || true",
    "build": "tsc -b && vite build",
    "vercel-build": "npm run build",
    "lint": "eslint .",
    "preview": "vite preview",
    "db:push": "drizzle-kit push",
    "db:migrate": "tsx scripts/migrate-local.ts",
    "db:studio": "drizzle-kit studio",
    "admin:reset-password": "tsx scripts/reset-admin-password.ts"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.4.5",
    "@fontsource/mukta": "^5.2.8",
    "@fontsource/noto-sans-telugu": "^5.2.8",
    "@hono/node-server": "^2.0.2",
    "@hookform/resolvers": "^5.2.2",
    "@neondatabase/serverless": "^1.1.0",
    "bcryptjs": "^3.0.3",
    "concurrently": "^9.2.1",
    "dayjs": "^1.11.20",
    "dexie": "^4.4.2",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.12.19",
    "html2canvas": "^1.4.1",
    "jose": "^6.2.3",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-hook-form": "^7.76.0",
    "react-router-dom": "^7.15.1",
    "react-window": "^2.2.7",
    "recharts": "^3.8.1",
    "xlsx": "^0.18.5",
    "zod": "^4.4.3",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^24.12.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/react-window": "^1.8.8",
    "@vercel/node": "^5.8.2",
    "@vitejs/plugin-react": "^6.0.1",
    "drizzle-kit": "^0.31.10",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "tailwindcss": "^4.3.0",
    "tsx": "^4.22.1",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.59.2",
    "vite": "^8.0.12",
    "vite-plugin-pwa": "^1.3.0",
    "wait-on": "^9.0.10",
    "workbox-window": "^7.4.1"
  }
}
